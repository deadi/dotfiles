# ssh
alias sdoc='ssh adi@doc.krang.lan'
alias shoa='ssh pi@hoa.krang.lan'
alias siot='ssh pi@iot.krang.lan'

# git
alias gst='git status'
alias ga='git add .'
alias gaa='git add --all'
alias gc='git commit'
alias gcm='git commit -m'
alias gca='git commit --amend'
alias gcam='git commit --amend -m'

# other
alias ll='ls -lah'

# files
alias ya='yazi'

# bat is called batcat on Debian/Ubuntu
if command -v batcat >/dev/null 2>&1; then
    BAT_CMD=batcat
elif command -v bat >/dev/null 2>&1; then
    BAT_CMD=bat
fi

if command -v fzf >/dev/null 2>&1 && [ -n "$BAT_CMD" ]; then
    alias ff="fzf --preview '$BAT_CMD --style=numbers --color=always {}'"
fi
#editor
alias vi='nvim'

# python
alias py='python3'

# Core shortcuts
alias d='docker'
alias dc='docker compose'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias di='docker images'

# Compose lifecycle
alias dcu='docker compose up -d'
alias dcd='docker compose down'
alias dcr='docker compose restart'
alias dcl='docker compose logs -f'
alias dcp='docker compose pull'
alias dcb='docker compose build'
alias dcps='docker compose ps'

# Logs / exec
alias dl='docker logs -f'
alias dex='docker exec -it'
alias dsh='docker exec -it $1 sh'      # note: needs a function, not alias, to take args cleanly
